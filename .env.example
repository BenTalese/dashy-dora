# ──────────────────────────────────────────────────────────────────────
# Dashy Dora — runtime configuration
# ──────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in for your environment. Every variable is
# optional — defaults shown are what the app falls back to. The compose
# file at repo root reads these.
#
# Env vars take precedence over the JSON appsettings file at
# `<DORA_DATA_DIR>/config/dapi.appsettings.json`, so you can override anything here
# without editing files inside the image.
# ──────────────────────────────────────────────────────────────────────


# ── Runtime profile (D3) ─────────────────────────────────────────────
# Selects the profile that drives sensible defaults for log level,
# debug mode, CORS, and seed behaviour. Accepted values:
#   development | production | test
# Aliases accepted: dev, prod, local, testing, ci.
#
# Production also REQUIRES the following vars to be set (the app
# refuses to boot otherwise, printing a friendly list of what's
# missing): DORA_SECRET_KEY, DORA_CORS_ORIGINS, ADMIN_BOOTSTRAP_EMAIL.
DORA_ENV=development


# ── Container basics ─────────────────────────────────────────────────
# Timezone used for log timestamps + scheduled tasks (audit retention
# sweep). Australia/Sydney by default.
TZ=Australia/Sydney


# ── Secrets / auth ───────────────────────────────────────────────────
# Signs the Flask session cookie. MUST be set to a long random string
# in production. If unset, the app writes a random key to
# `data/.secret_key` on first boot so sessions survive restarts — fine
# for local dev, not for prod.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
DORA_SECRET_KEY=

# Wrapping key for encrypted secrets (KEK).
# Fernet key that encrypts every secret Dora stores at rest: the
# install-wide SMTP password, the VAPID private key, and per-user paid-
# provider LLM API keys. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED on a server install before email, push or paid AI keys can be
# saved in Settings. On the desktop bundle the wrapping key is auto-
# generated into `<DATA_DIR>/.secret_encryption_key` on first launch —
# end users never see this variable. Rotating the key invalidates every
# stored ciphertext; the admin re-enters secrets in Settings.
DORA_SECRET_ENCRYPTION_KEY=

# How many reverse proxies sit in front of the API. 0 (default) = none —
# the connecting address is the client. Set to 1 behind one proxy (nginx,
# Caddy, Traefik, a Cloudflare tunnel) so the login rate limit and the
# audit log record the real client address from X-Forwarded-For instead
# of the proxy's. Never trust more hops than proxies you control: every
# trusted hop is an address a direct client could forge.
DORA_TRUSTED_PROXY_HOPS=0

# Whether the session cookie carries the `Secure` attribute. Default
# is profile-driven: production ⇒ true (fail-closed), development ⇒
# false. Set explicitly here to override, e.g. `false` for a
# LAN-behind-VPN prod install that deliberately serves plain HTTP.
DORA_SECURE_COOKIES=

# Set to true to wipe and re-seed the database on startup. Only
# honoured in development (production refuses regardless — the
# DORA_ENV gate prevents accidental data loss).
DORA_ALLOW_DESTRUCTIVE=false

# Which dev dataset a re-seed builds. `dense` (default) is a small
# hand-built household with no generated filler — every row exists to
# put some surface into a state worth looking at. `bulk` is the older
# curated set plus DORA_SEED_BULK_ITEMS generated stock items, for
# finding N+1s and slow queries under volume. Only consulted when a
# seed actually runs (see DORA_ALLOW_DESTRUCTIVE above); the backend
# e2e suite always uses `bulk` regardless of this.
DORA_SEED_DATASET=dense

# Comma-separated list of allowed CORS origins. REQUIRED in
# production. Dev defaults cover the web SPA on localhost AND the
# Capacitor mobile client (capacitor://localhost on iOS,
# http://localhost on Android) so a mobile build pointed at a dev
# backend Just Works. Production must enumerate every host the SPA
# and mobile clients reach you from, e.g.:
#   DORA_CORS_ORIGINS=https://dora.example.com,capacitor://localhost
DORA_CORS_ORIGINS=


# ── Storage paths ────────────────────────────────────────────────────
# All paths can be absolute or relative-to-cwd. Inside the container
# the defaults below map to named volumes (see compose.yml).
DORA_DATA_DIR=/app/data
DORA_CACHE_DIR=/app/cache
DORA_LOG_DIR=/app/logs

# Pin the sqlite db location explicitly. When unset, the app derives
# it from DORA_DATA_DIR (`<DATA_DIR>/dora.data.db`).
DORA_DB_PATH=

# Where Piper TTS voice models are stored. Unset = `<DATA_DIR>/voices`,
# which rides the data volume and is captured by backups. Only set this
# if you stage voice models on a different mount.
DORA_PIPER_VOICE_DIR=


# ── Database: pointing at Postgres ───────────────────────────────────
# Resolution order is DORA_DB_URL → DORA_DB_PATH → the per-component
# vars below → localhost:5432/dora. Give a full URL when the shape is
# unusual; use the components when only the credentials vary.
#   DORA_DB_URL=postgresql+psycopg://user:pass@host:5432/dbname
DORA_DB_URL=
DORA_DB_HOST=
DORA_DB_PORT=
DORA_DB_NAME=
DORA_DB_USER=
DORA_DB_PASSWORD=


# ── Support channel ──────────────────────────────────────────────────
# Where "Report an issue" and the Help links point. Deliberately env-only
# rather than an admin setting — whoever runs the install decides who
# receives the reports. Unset = the project defaults.
DORA_SUPPORT_URL=
DORA_SUPPORT_EMAIL=


# ── Demo mode ────────────────────────────────────────────────────────
# Serves a curated showcase dataset behind a permanent banner and resets
# itself back to that baseline on an interval, so anyone clicking around
# can't permanently change it. Env-only on purpose: the demo user is an
# admin, and this stops them switching it off from Settings. Off unless
# set. `DORA_DEMO_RESET_MINUTES` defaults to 60; 0 disables the reset.
DORA_DEMO_MODE=
DORA_DEMO_RESET_MINUTES=


# ── Dora API tuning ──────────────────────────────────────────────────
DORA_API_PORT=5170
# DEBUG | INFO | WARNING | ERROR | CRITICAL | FATAL
DORA_LOG_LEVEL=ERROR
# Set DORA_DEBUG=true to enable Flask's debug mode. Off in prod.
DORA_DEBUG=

# ── API server (FU-397) ──────────────────────────────────────────────
# Production runs a real WSGI server (gunicorn) instead of Flask's dev
# server. `auto` (default) picks gunicorn when DORA_ENV=production and the
# Flask dev server otherwise; force with `gunicorn` or `flask`.
DORA_API_SERVER=auto
# gunicorn tuning (see gunicorn.conf.py). LEAVE DORA_WEB_CONCURRENCY AT 1
# for a self-host instance: the app runs an in-process scheduler (alerts
# digest/push, audit prune, demo reset) that must fire once — more workers
# would duplicate those jobs. Concurrency comes from threads instead.
# Horizontal scale (multiple workers/processes) needs the worker-split work
# tracked in docs/04_proposals/OPTIONAL_SAAS_AND_MANAGED_DEPLOYMENT.md.
DORA_WEB_CONCURRENCY=1
DORA_WEB_THREADS=4
# Per-request timeout in seconds (0 disables). Bumped from gunicorn's 30s
# default so a slow import / PDF render / TTS synth doesn't kill the worker.
DORA_WEB_TIMEOUT=120


# ── First-run admin ──────────────────────────────────────────────────
# On a fresh database, the first user to register becomes admin. If
# this var is set, the boot routine instead creates an admin account
# with this email (random password — reset via the forgot-password
# flow). Useful for headless deployments where there's no human at
# the keyboard for the first registration.
ADMIN_BOOTSTRAP_EMAIL=


# ── AI assistant ─────────────────────────────────────────────────────
# Opt-in and configured *in-app* (Settings → System → AI assistant,
# admin only) — not via env. Run your own LLM (e.g. Ollama), then
# point Dora at it from the settings page. Nothing is enabled or
# downloaded by default.


# ── Operational config (email, push, voice, hosting) — in-app only ───
# FU-333 (2026-07-06): SMTP host/port/username/password, VAPID keys +
# subject, Piper binary + voice paths, `email_enabled`,
# `audit_retention_days`, and `public_url` all live on `AppSetting`
# and are edited under Settings → Admin → System (Email / Push / Voice
# / Hosting). No env vars for these any more; the previous
# `DORA_SMTP_*` / `DORA_VAPID_*` / `DORA_PIPER_*` / `DORA_EMAIL_ENABLED`
# / `DORA_AUDIT_RETENTION_DAYS` / `DORA_PUBLIC_URL` fallbacks were
# dropped pre-release. See `docs/04_proposals/IMPL_PLAN_ENV_TO_APPSETTING.md`.
